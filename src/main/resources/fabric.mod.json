{
  "schemaVersion": 1,
  "id": "routeweaver",
  "version": "${version}",
  "name": "RouteWeaver",
  "description": "Routes connections to chosen Minecraft servers through Shadowsocks proxies.",
  "authors": [
    "DverkaSK"
  ],
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": [
      "ru.dverkask.routeweaver.client.RouteWeaverClient"
    ]
  },
  "mixins": [
    {
      "config": "routeweaver.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  }
}
