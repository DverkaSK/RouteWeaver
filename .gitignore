# vibevm — everything vibe creates stays local, never committed.
# Manifest and lockfile
/vibe.toml
/vibe.lock
# Agent boot entry points generated by `vibe init`
/CLAUDE.md
/AGENTS.md
/GEMINI.md
# Cold-resume snapshot written by flow:wal on session wind-down
/CONTINUE.md
# Authored specs, boot lanes, WAL and materialised packages
/vibevm/
# Root links to vibevm/vibedeps and vibevm/vibespecs
/vibedeps
/vibespecs
# Per-project cache, lifecycle state, personal settings
/.vibe/
# Boot-artifact control files, wherever they land
**/.vibe-boot-*
# Agentic relay mailbox
**/.vibe/agentic/

# Claude Code local settings
/.claude/

# Gradle / Loom / Kotlin build output
.gradle/
build/
out/
run/
.kotlin/
*.class

# Agent binaries
/agent/*.exe
/agent/routeweaver-agent
/agent/proxy-agent

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
